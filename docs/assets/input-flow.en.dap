sequence
title "Handling one input"
subtitle "An input reaches the provider only after the record store has accepted it"

box tui "tui"
box engine "engine"
box core "core"
external router "router"
external provider "provider"
store database "database"

step "Accept" "engine has the record store accept the input, and core sets the judgment turn in acceptance order"
  tui -> engine "input"
  engine -> database "accept input"
  engine -> core "request judgment turn"
  core -> engine "acceptance order" dashed
step "Judge" "From the router's answer, core decides the target agent and how to handle the input"
  engine -> router "judgment query"
  router -> engine "probability per choice" dashed
  engine -> core "apply judgment"
  core -> engine "target agent, handling" dashed
step "Deliver and record" "At send time engine picks the target session and sends to the provider only after recording delivering"
  engine -> core "pick target session"
  core -> engine "target session" dashed
  engine -> database "record delivering"
  engine -> provider "deliver to target session"
  provider -> engine "events, usage report" dashed
  engine -> database "record events"
  engine -> tui "result line" dashed
