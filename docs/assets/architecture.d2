direction: right
user: Developer {shape: person}
system: Saturn {
  cli: cli
  tui: tui
  engine: engine
  core: core
  protocol: protocol
  database: SQLite record store {shape: cylinder}
  cli -> engine: starts
  cli -> tui: launches
  tui -> engine: JSON-RPC
  tui -> protocol: message types
  engine -> core: queue, sessions, judgment rules
  engine -> protocol: message types
  engine -> database: records
}
codex-cli: Codex CLI {style.stroke-dash: 4}
claude-code: Claude Code {style.stroke-dash: 4}
router-api: Router API {style.stroke-dash: 4}
user -> system.cli: commands
user -> system.tui: input
system.engine -> codex-cli: app-server requests
system.engine -> claude-code: stream-json input
system.engine -> router-api: judgment questions
