flow right
title "engine 시작 순서"
subtitle "앞 단계가 실패하면 뒤 단계를 하지 않는다"

box lock "rpc" "사용자당 engine 잠금을 얻는다"
box schema "store" "스키마가 올라갔으면 이관한다"
box sessions "sessions" "끝나지 않은 session의 마지막 턴 값을 되살린다"
box settings "settings" "기본값, 사용자, 실행 층을 병합한다"
box routers "routers" "router가 응답하는지 확인한다"
box listen "rpc" "Unix 소켓에서 JSON-RPC 접속을 받는다"
box multi "rpc" "여러 TUI의 접속을 동시에 유지한다"

lock -> schema no=1
schema -> sessions no=2
sessions -> settings no=3
settings -> routers no=4
routers -> listen no=5
listen -> multi no=6

step "시작" "cli가 띄운 engine이 순서대로 준비한다"
  lock -> schema
  schema -> sessions
  sessions -> settings
  settings -> routers
  routers -> listen
  listen -> multi
